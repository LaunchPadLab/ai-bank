# Copy to .env and fill in. Do NOT commit .env (it is gitignored).
#
# Cloudflare Tunnel token: Zero Trust dashboard > Networks > Tunnels > (your tunnel) > Install
# (the long token in the `cloudflared ... run <TOKEN>` command). Used by docker-compose.yml.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: pin a specific published image instead of :latest (e.g. AIBANK_IMAGE_TAG=sha-abc1234).
# AIBANK_IMAGE_TAG=latest
# Optional: override the image entirely (e.g. a different registry/owner).
# AIBANK_IMAGE=ghcr.io/launchpadlab/aibank-mcp
